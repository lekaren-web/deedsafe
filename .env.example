# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=[]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local-only test account for development (see supabase/config.toml)
TEST_NOTARY_EMAIL=
TEST_NOTARY_PASSWORD=
